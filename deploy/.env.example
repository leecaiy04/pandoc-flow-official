# ============================================
# Cloudflare + NPM + SunPanel 环境变量模板
# 复制为 .env 并填入实际值:  cp .env.example .env
# ============================================

# ---------- Cloudflare ----------
# API Token (获取方式见 deploy/README.md)
CF_API_TOKEN=your_cloudflare_api_token_here

# 你的主域名 (已托管到 Cloudflare)
CF_DOMAIN=example.com

# ---------- 子域名分配 ----------
# 主服务 (原端口 50000 → HTTPS 443)
MAIN_SUBDOMAIN=app.example.com

# SunPanel 导航面板
SUNPANEL_SUBDOMAIN=home.example.com

# NPM 管理面板
NPM_SUBDOMAIN=npm.example.com

# ---------- 通用 ----------
# 时区
TZ=Asia/Shanghai
